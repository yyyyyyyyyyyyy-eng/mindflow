{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MindFlow",
  "version": "0.1.0",
  "identifier": "com.yiyi.mindflow",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MindFlow",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
