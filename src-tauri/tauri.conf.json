{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MindFlow",
  "version": "0.1.0",
  "identifier": "com.yiyi.mindflow",
  "build": {
    "frontendDist": "../apps/desktop/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm -C apps/desktop dev",
    "beforeBuildCommand": "pnpm -C apps/desktop build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MindFlow",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
