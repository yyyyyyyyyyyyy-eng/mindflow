{
  "identifier": "default",
  "description": "MindFlow 文件系统 + 对话框权限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:path:default",
    "fs:default",
    "fs:scope-home",
    "fs:allow-home-read",
    "fs:allow-home-write",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-remove",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "dialog:default"
  ]
}
