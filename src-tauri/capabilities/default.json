{
  "identifier": "default",
  "description": "MindFlow 全量权限（递归作用域 + 二进制读写 + 对话框）",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:path:default",
    "fs:default",
    "fs:scope-home-recursive",
    "fs:allow-home-read-recursive",
    "fs:allow-home-write-recursive",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-remove",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
